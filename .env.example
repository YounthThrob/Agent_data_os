# 运行环境：development / test / production
ADOS_ENVIRONMENT=development

# 仅允许本地开发使用。production环境即使误设为true也会拒绝启动。
ADOS_ALLOW_INSECURE_DEV_AUTH=true

ADOS_SERVICE_NAME=agent-data-os
ADOS_LOG_LEVEL=INFO
ADOS_DEFAULT_QUERY_LIMIT=20
ADOS_MAX_QUERY_LIMIT=100

# PostgreSQL生产示例：postgresql+psycopg://ados:password@postgres:5432/ados
# 开发环境可使用：sqlite+pysqlite:///./ados-dev.db
ADOS_DATABASE_URL=
ADOS_DATABASE_ECHO=false

# 只允许development/test自动建表；production必须使用Alembic迁移。
ADOS_DATABASE_AUTO_CREATE=false
